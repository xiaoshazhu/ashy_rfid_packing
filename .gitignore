# 忽略系统文件
.DS_Store
Thumbs.db

# 忽略所有老的 git 仓库备份
**/.git_bak/
.git_bak/

# 忽略所有大的 exe 安装包
*.exe

# 忽略 Python 缓存和打包产物
**/__pycache__/
*.pyc
Desktop_QR_Send/build/
Desktop_QR_Send/dist/
Desktop_QR_Send/*.spec

# 忽略数据库、运行记录和本地日志
**/*.db
**/*.sqlite
**/*.sqlite3
**/records/
**/*.csv
**/logs/
*.log

# 忽略本地密钥和私有配置
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/secrets.json
**/config.local.json

# 忽略 PyCharm 配置
.idea/

# 忽略临时测试大图片
**/test2.bmp
**/processed_image.png
