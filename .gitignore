# 忽略系统文件
.DS_Store
Thumbs.db

# 忽略所有老的 git 仓库备份
**/.git_bak/
.git_bak/

# 忽略所有大的 exe 安装包
*.exe

# 忽略 Python 缓存和打包产物
**/__pycache__/
*.pyc
Desktop_QR_Send/build/
Desktop_QR_Send/dist/
Desktop_QR_Send/*.spec

# 忽略数据库、运行记录和本地日志
**/*.db
**/*.sqlite
**/*.sqlite3
**/records/
**/*.csv
**/logs/
*.log

# 忽略本地密钥和私有配置
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/secrets.json
**/config.local.json

# 忽略 PyCharm 配置
.idea/

# 忽略临时测试大图片
**/test2.bmp
**/processed_image.png

# 厂家运行库、设备电脑备份和本地硬件资料不进入公开代码仓库
Desktop_QR_Send/vendor/
Desktop_QR_Send/Template/
Desktop_QR_Send/Template_en/
Desktop_QR_Send/plugins/
Desktop_QR_Send/res/
Desktop_QR_Send/*.dll
Desktop_QR_Send/*.img
Desktop_QR_Send/sdkcfg.xml
Desktop_QR_Send/原设备电脑备份信息/
WDIP24-15-R导轨式隔离型可调电源上位机软件及Modbus通讯协议/
TD-39系列*.pdf
*.ocx
*.scc

# 设计源文件、渲染结果和临时工作目录
*.ai
output/
tmp/
